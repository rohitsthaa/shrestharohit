---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout title="About Rohit Shrestha">
  <div class="page about-page">
    <section class="about-hero">
      <div class="about-copy">
        <p class="eyebrow">About</p>
        <h1>Rohit Shrestha</h1>
        <p class="lead">
          Senior Software Engineer / Consultant with a hybrid background in product engineering and public health data systems. I build scalable backend services (.NET Core, Python, Node.js), craft reliable APIs, and deliver data platforms that turn fragmented health and legal operations data into actionable insight.
        </p>
        <ul class="quick-stats">
          <li><strong>Role:</strong> Senior Software Engineer / Consultant</li>
          <li><strong>Focus:</strong> Backend, Health Data Systems</li>
          <li><strong>Experience:</strong> 8+ yrs</li>
          <li><strong>Current:</strong> LeanLaw</li>
          <li><strong>Location:</strong> Kathmandu, Nepal (NPT)</li>
        </ul>
        <p class="micro-mission">I help teams ship reliable APIs, modernize data reporting, and turn health operations data into actionable insight.</p>
      </div>
      <img src={`${base}img/rohit.png`} alt="Rohit Shrestha - Senior Software Engineer" width="260" height="260" class="headshot" loading="lazy" />
    </section>

    <h2 id="snapshot">Professional Snapshot</h2>
    <ul>
      <li><strong>Experience:</strong> 8+ years across SaaS, health informatics, and consulting (Nepal & remote global teams).</li>
      <li><strong>Current Focus:</strong> Backend/API engineering at <em>LeanLaw</em> (feature delivery & system stability) plus selective health data consulting.</li>
      <li><strong>Approach:</strong> Pragmatic, data-driven, latency & correctness first; communicate early; automate recurring ops.</li>
    </ul>

    <h2 id="core-skills">Core Skills</h2>
    <div class="skill-grid">
      <p><strong>Languages:</strong> C#, Python, JavaScript/TypeScript</p>
      <p><strong>Frameworks:</strong> .NET Core, Django, Node.js, React</p>
      <p><strong>Architecture:</strong> Microservices, REST API design, caching, indexing & query optimization</p>
      <p><strong>Cloud & Infra:</strong> AWS (EC2, RDS, S3, Lambda, SQS, Load Balancers)</p>
      <p><strong>Health Systems:</strong> DHIS2 implementations, surveillance dashboards, real-time data flows</p>
      <p><strong>Other:</strong> Stripe integrations, training & stakeholder alignment, system hardening</p>
    </div>

    <h2 id="experience">Selected Experience</h2>
    <div class="role">
      <h3>Senior Software Engineer - LeanLaw <span class="period">Jan 2022 - Present</span></h3>
      <ul>
        <li>Lead and evolve backend (.NET Core) services powering legal billing & accounting workflows.</li>
        <li>Drove stability & performance initiatives (error rate + latency reductions, targeted optimizations).</li>
        <li>Partner with product & frontend to scope features; mentor on API design & resiliency patterns.</li>
      </ul>
    </div>
    <div class="role">
      <h3>IT Consultant - NHSSP / Save the Children / GIZ / NTC (Multiple Engagements)</h3>
      <ul>
        <li>Planned & implemented DHIS2 tracker and aggregate modules (OCMC, SSU, TB, community health workers).</li>
        <li>Upgraded legacy DHIS2 deployments to support evolving reporting schemas.</li>
        <li>Designed & delivered trainings for government staff, improving data quality & adoption.</li>
        <li>Coordinated with WHO & GIZ on Go.Data for contact tracing; ensured operational continuity.</li>
      </ul>
    </div>
    <div class="role">
      <h3>Software Engineer - InnovateTech <span class="period">Jun 2020 - Dec 2021</span></h3>
      <ul>
        <li>Built scalable, fault-tolerant microservices; optimized legacy APIs via caching & indexing.</li>
        <li>Contributed to frontend (React) for end-to-end feature delivery.</li>
      </ul>
    </div>
    <div class="role">
      <h3>Senior Software Engineer - Hitched Inc <span class="period">Aug 2019 - Dec 2019</span></h3>
      <ul>
        <li>Delivered Stripe-based payment processing & performant mobile-facing APIs.</li>
        <li>Operated workloads on AWS (EC2, RDS, load balancer) with reliability focus.</li>
      </ul>
    </div>
    <div class="role">
      <h3>Software Engineer - Insight Workshop <span class="period">May 2018 - Jul 2019</span></h3>
      <ul>
        <li>Designed & developed core internal services for US-based enterprise clients.</li>
        <li>Handled risk analysis, stakeholder communication, and AWS infrastructure (EC2, RDS, S3).</li>
        <li>Implemented secure Stripe payment flows.</li>
      </ul>
    </div>
    <p class="more-note">Earlier: Multiple DHIS2 / health data consulting roles (2016-2018) including portal & dashboard development, contract management systems, and capacity-building workshops.</p>

    <h2 id="projects">Highlighted Projects</h2>
    <ul>
      <li><strong>National Health Sector Progress Portal:</strong> Monitored strategy KPIs (NHSSP) - improved visibility for policymakers.</li>
      <li><strong>Real-time Genexpert Dashboard:</strong> Aggregated nationwide test results to accelerate tuberculosis response.</li>
      <li><strong>Contact Tracing (Go.Data) Support:</strong> Ensured stable deployment & data coherence across agencies.</li>
      <li><strong>Digital Reporting (Robson Classification):</strong> Streamlined obstetric metrics collection for hospital operations.</li>
      <li><strong>Stripe Payment Integrations:</strong> Reliable transactional flows for SaaS and consumer apps.</li>
    </ul>

    <h2 id="awards">Awards & Recognition</h2>
    <ul>
      <li>Ncell App Competition 2016 - Tourism Category Winner (Android app "PinPeaks").</li>
      <li>NASA International Space Apps Challenge 2015 - Top 15 Semi-Finalist ("AstroAct").</li>
    </ul>

    <h2 id="education">Education</h2>
    <p>BE Computer Engineering - Kathmandu University (2012-2016)</p>

    <h2 id="contact">Contact & Availability</h2>
    <p>Open to: backend engineering roles, health data platform consulting, and impactful SaaS problems.</p>
    <p><strong>Email:</strong> <a href="mailto:hello@shrestharohit.com.np">hello@shrestharohit.com.np</a><br />
       <strong>Website:</strong> <a href="https://shrestharohit.com.np" target="_blank" rel="noopener">shrestharohit.com.np</a><br />
       <strong>LinkedIn:</strong> <a href="https://www.linkedin.com/in/shrestharohit" target="_blank" rel="noopener">/in/shrestharohit</a>
    </p>
    <p>If you have a challenging data or API scaling problem, let's talk.</p>
  </div>
</BaseLayout>

<style>
  .about-page {
    max-width: 900px;
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 2rem;
    align-items: start;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .lead {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .headshot {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--shadow);
  }

  .quick-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
    padding: 0;
    margin: 1.5rem 0;
    list-style: none;
  }

  .quick-stats li,
  .skill-grid p {
    margin: 0;
    padding: .8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, .62);
    color: var(--muted);
    font-size: .92rem;
  }

  .micro-mission {
    margin: 0;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
    margin: 1.25rem 0;
  }

  .period {
    display: inline-block;
    color: var(--muted-2);
    font-weight: 600;
    font-size: .9rem;
    margin-left: .35rem;
  }

  .role {
    margin-top: 1.25rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, .6);
  }

  .role h3 {
    margin-top: 0;
  }

  .role ul {
    margin-bottom: 0;
  }

  .more-note {
    color: var(--muted);
    font-size: .95rem;
    font-style: italic;
  }

  #contact a {
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .about-hero,
    .skill-grid {
      grid-template-columns: 1fr;
    }

    .headshot {
      width: 180px;
      height: 180px;
      order: -1;
    }

    .quick-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
