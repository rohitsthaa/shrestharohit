---
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const aboutUrl = import.meta.env.DEV ? `${base}about/` : 'https://shrestharohit.com.np/about/';

const experience = [
  {
    range: '2022 — Now',
    company: 'LeanLaw',
    role: 'Senior Software Engineer',
    location: 'Remote · US',
    notes: [
      'Lead engineer of the Nepal team, working across the billing & trust accounting domain.',
      'Rebuilt the QuickBooks Online sync layer; cut reconciliation drift to near zero across thousands of firms.',
      'Mentor engineers, run architecture reviews, own the C#/.NET service layer.',
    ],
    tech: ['.NET', 'C#', 'Postgres', 'QuickBooks API'],
  },
  {
    range: '2020 — 2021',
    company: 'InnovateTech',
    role: 'Software Engineer',
    location: 'Kathmandu',
    notes: [
      'Built scalable, fault-tolerant microservices and optimized legacy APIs via caching & indexing.',
      'Contributed to frontend (React) for end-to-end feature delivery.',
    ],
    tech: ['Node.js', 'React', 'AWS', 'Postgres'],
  },
  {
    range: '2016 — 2020',
    company: 'NHSSP / Save the Children / GIZ',
    role: 'IT Consultant',
    location: 'Kathmandu',
    notes: [
      'Designed and shipped DHIS2 tracker modules for national disease surveillance programs covering 77 districts.',
      'Coordinated with WHO & GIZ on Go.Data for contact tracing; ensured operational continuity.',
      'Built reporting and offline-first data collection tools for child-protection programs in low-connectivity regions.',
    ],
    tech: ['Python', 'Django', 'DHIS2', 'Postgres'],
  },
  {
    range: '2018 — 2019',
    company: 'Hitched Inc / Insight Workshop',
    role: 'Software Engineer',
    location: 'Kathmandu',
    notes: [
      'Delivered Stripe-based payment processing & performant mobile-facing APIs on AWS.',
      'Designed core internal services for US-based enterprise clients.',
    ],
    tech: ['Python', 'Django', 'AWS', 'Stripe'],
  },
];

const stack = [
  { group: 'Languages', items: ['C#', 'Python', 'TypeScript', 'SQL'] },
  { group: 'Frameworks', items: ['.NET', 'Django', 'ASP.NET Core', 'React'] },
  { group: 'Infra', items: ['Postgres', 'Redis', 'Docker', 'AWS'] },
  { group: 'Practice', items: ['DDD', 'Event sourcing', 'API design', 'Testing'] },
];

const social = [
  { label: 'GitHub', handle: '@rohitshrestha', href: 'https://github.com/rohitshrestha' },
  { label: 'LinkedIn', handle: '/in/shrestharohit', href: 'https://www.linkedin.com/in/shrestharohit' },
  { label: 'Email', handle: 'hello@shrestharohit.com.np', href: 'mailto:hello@shrestharohit.com.np' },
  { label: 'RSS', handle: '/rss.xml', href: `${base}rss.xml` },
];
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rohit Shrestha — Senior Software Engineer</title>
  <meta name="description" content="Senior Software Engineer at LeanLaw. Backend-leaning generalist working across .NET and Python." />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="alternate icon" type="image/x-icon" href={`${base}favicon.ico`} />
  <link rel="sitemap" href={`${base}sitemap-index.xml`} />
  <link rel="alternate" type="application/rss+xml" title="RSS" href={`${base}rss.xml`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- Nav -->
  <nav class="nav">
    <div class="nav-mark">
      <span class="nav-dot"></span>
      R · S
    </div>
    <div class="nav-links">
      <a href={aboutUrl} class="nav-link">About</a>
      <a href="#work" class="nav-link">Work</a>
      <a href={`${base}writing/`} class="nav-link">Writing</a>
      <a href="#contact" class="nav-link">Contact</a>
    </div>
    <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
      <span id="themeLabel">◐ Light</span>
    </button>
  </nav>

  <!-- Hero -->
  <section class="hero" id="hero">

    <!-- Himalayan mountain parallax backdrop -->
    <div class="mtn-scene" aria-hidden="true">
      <!-- Layer 1: Distant high peaks -->
      <svg class="mtn-svg mtn-l1" viewBox="0 0 1440 560" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg">
        <path class="mtn-far"
          d="M-10,560 L0,330 L40,295 L80,258 L130,228 L165,198 L188,158 L208,180 L240,210 L272,188 L305,162 L345,138 L378,162 L408,182 L432,122 L455,145 L480,135 L505,142 L526,130 L550,114 L572,98 L595,116 L620,135 L648,155 L675,172 L700,186 L726,162 L752,140 L774,124 L798,108 L820,126 L845,142 L870,155 L895,138 L918,126 L946,144 L972,132 L998,142 L1022,128 L1050,118 L1078,112 L1106,130 L1130,145 L1156,158 L1184,178 L1214,194 L1248,188 L1280,198 L1315,208 L1350,195 L1390,206 L1440,200 L1450,560 Z"/>
        <!-- Natural snow — wider coverage following each peak's slopes -->
        <!-- Peak ~188,158 -->
        <path class="mtn-snow" d="M164,198 L172,182 L180,168 L188,158 L196,165 L208,180 L214,194 L204,196 L194,180 L184,175 L174,186 Z"/>
        <!-- Peak ~345,138 -->
        <path class="mtn-snow" d="M310,168 L324,154 L335,144 L345,138 L356,146 L368,160 L376,170 L360,172 L348,155 L336,150 L320,162 Z"/>
        <!-- Peak ~432,122 -->
        <path class="mtn-snow" d="M408,182 L418,162 L426,144 L432,122 L440,132 L452,148 L460,162 L447,165 L436,145 L424,148 L412,168 Z"/>
        <!-- Peak ~572,98 — tallest, most snow -->
        <path class="mtn-snow" d="M506,145 L518,132 L532,120 L544,112 L556,105 L572,98 L584,106 L596,116 L610,130 L622,142 L612,148 L598,134 L584,122 L572,104 L560,114 L546,122 L532,130 L518,138 Z"/>
        <!-- Peak ~798,108 — second tallest -->
        <path class="mtn-snow" d="M750,148 L762,134 L774,124 L784,115 L798,108 L810,116 L820,126 L832,140 L820,146 L808,130 L798,116 L784,122 L772,132 L758,144 Z"/>
        <!-- Peak ~918,126 -->
        <path class="mtn-snow" d="M892,145 L904,134 L912,128 L918,126 L926,130 L936,140 L944,150 L930,152 L918,134 L906,136 L896,146 Z"/>
        <!-- Peak ~1078,112 -->
        <path class="mtn-snow" d="M1044,128 L1056,118 L1066,114 L1078,112 L1090,116 L1104,128 L1112,138 L1098,140 L1082,122 L1068,120 L1052,130 Z"/>
      </svg>

      <!-- Layer 2: Mid-range peaks -->
      <svg class="mtn-svg mtn-l2" viewBox="0 0 1440 560" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg">
        <path class="mtn-mid"
          d="M-10,560 L0,430 L70,402 L140,388 L210,368 L268,350 L320,330 L365,348 L405,340 L435,318 L462,305 L490,290 L515,310 L542,295 L568,275 L595,295 L625,310 L660,290 L695,270 L720,255 L748,272 L775,285 L808,268 L840,252 L868,268 L895,278 L925,260 L958,248 L990,262 L1020,272 L1055,258 L1088,268 L1122,255 L1155,268 L1190,280 L1230,295 L1270,310 L1320,325 L1375,318 L1440,322 L1450,560 Z"/>
        <!-- Mid snow — lighter patches only on the highest sub-peaks -->
        <!-- Peak ~490,290 -->
        <path class="mtn-snow-mid" d="M464,310 L474,298 L482,292 L490,290 L498,294 L508,306 L514,316 L504,318 L492,300 L480,298 L468,312 Z"/>
        <!-- Peak ~720,255 -->
        <path class="mtn-snow-mid" d="M695,278 L706,268 L714,260 L720,255 L728,260 L738,270 L746,280 L734,284 L722,264 L710,264 L698,278 Z"/>
        <!-- Peak ~840,252 -->
        <path class="mtn-snow-mid" d="M812,275 L824,264 L834,256 L840,252 L848,256 L858,266 L866,276 L854,280 L842,260 L830,260 L816,275 Z"/>
        <!-- Peak ~958,248 -->
        <path class="mtn-snow-mid" d="M930,270 L942,258 L952,252 L958,248 L966,252 L976,262 L984,272 L972,276 L960,256 L948,256 L934,270 Z"/>
        <!-- Peak ~1122,255 -->
        <path class="mtn-snow-mid" d="M1096,276 L1108,264 L1116,258 L1122,255 L1130,258 L1140,268 L1148,278 L1136,282 L1124,262 L1112,262 L1100,276 Z"/>
      </svg>

      <!-- Layer 3: Near ridges — raised and more distinct -->
      <svg class="mtn-svg mtn-l3" viewBox="0 0 1440 560" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg">
        <path class="mtn-near"
          d="M-10,560 L0,448 L60,428 L130,440 L210,418 L300,435 L390,412 L475,430 L560,405 L645,422 L730,400 L815,418 L900,398 L985,418 L1065,400 L1150,420 L1240,438 L1330,428 L1440,435 L1450,560 Z"/>
      </svg>

      <!-- Atmospheric haze -->
      <div class="mtn-haze"></div>
      <!-- Text shield: darkens behind the name on the left -->
      <div class="mtn-shield"></div>
    </div>

    <div class="hero-content">
    <div class="hero-eyebrow">
      Senior Software Engineer — LeanLaw · Kathmandu, Nepal
    </div>
    <h1 class="hero-name">Rohit<br/>Shrestha.</h1>
    <div class="hero-grid">
      <div class="hero-label">(Intro)</div>
      <p class="hero-blurb">
        Backend-leaning generalist working across .NET and Python. I build the unglamorous plumbing that keeps products honest — domain models, integrations, the boring parts that decide whether software ages well.
      </p>
      <div class="hero-kv">
        <div class="kv-rows">
          <div class="kv-row">
            <span class="kv-key">Experience</span>
            <span class="kv-val">8+ years</span>
          </div>
          <div class="kv-row">
            <span class="kv-key">Now</span>
            <span class="kv-val">Senior Software Engineer · LeanLaw</span>
          </div>
          <div class="kv-row">
            <span class="kv-key">Based</span>
            <span class="kv-val">Kathmandu, Nepal</span>
          </div>
          <div class="kv-row">
            <span class="kv-key">Status</span>
            <span class="kv-val kv-val--status">
              <span class="status-dot"></span>Open to interesting conversations
            </span>
          </div>
        </div>
        <div class="kv-clock-panel">
          <div class="kv-clock-label">Local time · Kathmandu</div>
          <div class="kv-clock-display">
            <span id="npt-clock">--:--:--</span>
          </div>
          <div class="kv-clock-meta">Nepal Standard Time · UTC+5:45</div>
        </div>
      </div>
    </div>
    </div><!-- /.hero-content -->
  </section>

  <!-- About -->
  <section class="section section--topo" id="about">
    <div class="section-header">
      <span class="section-num">§ 01</span>
      <span class="section-label">About</span>
    </div>
    <div class="about-grid reveal">
      <div></div>
      <div class="about-bio">
        <p>I have spent the last eight years writing software for legal tech, public health, and humanitarian programs. The throughline is the same: take messy, real-world process and shape it into something a small team can hold in their head.</p>
        <p>I care about clear domain boundaries, tests that read like documentation, and tooling that respects the next person who has to read the code. I try to write things that are easy to delete.</p>
      </div>
      <div class="stack-groups">
        {stack.map(g => (
          <div class="stack-group">
            <div class="stack-group-label">{g.group}</div>
            <div class="chips">
              {g.items.map(item => <span class="chip">{item}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="section" id="work">
    <div class="section-header">
      <span class="section-num">§ 02</span>
      <span class="section-label">Experience</span>
    </div>
    <div class="experience-list">
      {experience.map((e, i) => (
        <div class={`exp-row reveal${i === 0 ? ' exp-row--first' : ''}`}>
          <div class="exp-range">{e.range}</div>
          <div class="exp-main">
            <h3 class="exp-company">{e.company}</h3>
            <div class="exp-meta">{e.role} · {e.location}</div>
            <div class="exp-tech">
              {e.tech.map(t => <span class="tech-chip">{t}</span>)}
            </div>
          </div>
          <ul class="exp-notes">
            {e.notes.map(n => <li>{n}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Writing -->
  <section class="section" id="writing">
    <div class="section-header">
      <span class="section-num">§ 03</span>
      <span class="section-label">Writing</span>
    </div>
    <div class="writing-list">
      {allPosts.map((post) => {
        const date = post.data.pubDate;
        const dateStr = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;
        const minutes = Math.ceil((post.data.description?.length ?? 300) / 200 + 4);
        return (
          <a href={`${base}writing/${post.id}/`} class="writing-row reveal">
            <div class="wr-date">{dateStr}</div>
            <div class="wr-title">{post.data.title}</div>
            <div class="wr-blurb">{post.data.description ?? ''}</div>
            <div class="wr-min">{minutes} min →</div>
          </a>
        );
      })}
    </div>
    <div class="writing-footer">
      <a href={`${base}writing/`} class="writing-all">View all writing →</a>
    </div>
  </section>

  <!-- Footer / Contact -->
  <section class="contact-section reveal" id="contact">
    <div class="contact-num">§ 04 — Contact</div>
    <div class="contact-body">
      <h2 class="contact-heading">Get in touch.</h2>
      <p class="contact-sub">
        I read everything. Best reached by email — happy to talk if something seems worth talking about.
      </p>
      <a href="mailto:hello@shrestharohit.com.np" class="contact-email">
        hello@shrestharohit.com.np
      </a>
      <div class="social-links">
        {social.filter(s => s.label !== 'Email').map(s => (
          <a href={s.href} class="social-link" target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            {s.label}
          </a>
        ))}
      </div>
      <div class="footer-bar">
        <span>© {new Date().getFullYear()} R. Shrestha</span>
      </div>
    </div>
  </section>

</body>
</html>

<style>
  /* ── Tokens ── */
  :root {
    --bg: #f6f4ef;
    --panel: #ffffff;
    --fg: #141414;
    --muted: #6b6b66;
    --faint: #a8a8a2;
    --line: #e3e1da;
    --chip: #ebe9e2;
    /* Mountains — light mode */
    --mtn-far-fill:      rgba(155,168,188,0.38);
    --mtn-mid-fill:      rgba(132,148,168,0.45);
    --mtn-near-fill:     rgba(112,128,142,0.52);
    --mtn-snow-fill:     rgba(255,255,255,0.88);
    --mtn-snow-mid-fill: rgba(240,246,252,0.65);
    --mtn-haze-start:    rgba(246,244,239,0);
    --mtn-haze-end:      rgba(246,244,239,0.55);
  }
  [data-theme="dark"] {
    --bg: #0d0d0c;
    --panel: #141413;
    --fg: #ededea;
    --muted: #b0b0aa;
    --faint: #7a7a75;
    --line: #2e2e2a;
    --chip: #1c1c1a;
    /* Mountains — dark mode: subtle, text-friendly */
    --mtn-far-fill:      rgba(42,58,88,0.38);
    --mtn-mid-fill:      rgba(22,34,56,0.62);
    --mtn-near-fill:     rgba(10,16,30,0.88);
    --mtn-snow-fill:     rgba(165,192,225,0.42);
    --mtn-snow-mid-fill: rgba(145,175,210,0.22);
    --mtn-haze-start:    rgba(13,13,12,0);
    --mtn-haze-end:      rgba(13,13,12,0.55);
  }

  /* ── Reset ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { font-size: 16px; }
  body {
    font-family: "Geist", -apple-system, system-ui, sans-serif;
    font-feature-settings: "ss01", "cv11";
    letter-spacing: -0.005em;
    background: var(--bg);
    color: var(--fg);
    transition: background .25s ease, color .25s ease;
    overflow-x: hidden;
    padding-bottom: 0;
  }
  a { color: inherit; text-decoration: none; }

  /* ── Scroll reveal ── */
  .reveal { opacity: 0; transform: translateY(12px); transition: opacity .7s ease, transform .7s ease; }
  .reveal.in { opacity: 1; transform: none; }

  /* ── Nav ── */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32px 80px;
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 10;
    transition: background .25s ease;
  }
  .nav-mark {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg);
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .nav-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #3aa66b;
    box-shadow: 0 0 0 4px rgba(58,166,107,.18);
    flex-shrink: 0;
    animation: dot-pulse 3.5s ease-in-out infinite;
  }
  @keyframes dot-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(58,166,107,.18); }
    50%       { box-shadow: 0 0 0 9px rgba(58,166,107,.06); }
  }
  .nav-links {
    display: flex;
    gap: 36px;
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .nav-link {
    color: var(--muted);
    transition: color .2s;
  }
  .nav-link:hover { color: var(--fg); }
  .theme-toggle {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--fg);
    padding: 7px 14px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color .2s, color .2s;
  }
  .theme-toggle:hover { border-color: var(--fg); }

  /* ── Mountains ── */
  .mtn-scene {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .mtn-svg {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    will-change: transform;
  }
  .mtn-far      { fill: var(--mtn-far-fill);      transition: fill .25s ease; }
  .mtn-snow     { fill: var(--mtn-snow-fill);     transition: fill .25s ease; }
  .mtn-mid      { fill: var(--mtn-mid-fill);      transition: fill .25s ease; }
  .mtn-snow-mid { fill: var(--mtn-snow-mid-fill); transition: fill .25s ease; }
  .mtn-near     { fill: var(--mtn-near-fill);     transition: fill .25s ease; }
  .mtn-haze {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--mtn-haze-start) 35%, var(--mtn-haze-end) 100%);
    transition: background .25s ease;
  }
  .mtn-shield {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 75%, transparent) 30%,
      color-mix(in srgb, var(--bg) 20%, transparent) 58%,
      transparent 75%
    );
    transition: background .25s ease;
  }
  .mtn-l1 { transform: translateY(var(--mtn-p1, 0px)); }
  .mtn-l2 { transform: translateY(var(--mtn-p2, 0px)); }
  .mtn-l3 { transform: translateY(var(--mtn-p3, 0px)); }
  .hero-content {
    position: relative;
    z-index: 1;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    padding: 120px 80px 100px;
    border-bottom: 1px solid var(--line);
  }
  .hero-eyebrow {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 40px;
  }
  .hero-name {
    font-size: clamp(72px, 13vw, 168px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-weight: 500;
    color: var(--fg);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 180px 1fr 1fr;
    gap: 64px;
    margin-top: 64px;
    align-items: start;
  }
  .hero-label {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .hero-blurb {
    font-size: 22px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--fg);
    max-width: 520px;
  }
  .hero-kv {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--panel);
    box-shadow: 0 2px 24px rgba(20,20,20,.07);
  }
  .kv-rows { display: flex; flex-direction: column; }
  .kv-row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    align-items: center;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
  }
  .kv-key {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }
  .kv-val {
    font-size: 14px;
    font-weight: 500;
