<script>
  // Theme toggle
  const toggle = document.getElementById('themeToggle');
  const label = document.getElementById('themeLabel');
  const html = document.documentElement;

  const saved = localStorage.getItem('theme') ?? 'light';
  html.setAttribute('data-theme', saved);
  if (label) label.textContent = saved === 'light' ? '◐ Light' : '◑ Dark';

  toggle?.addEventListener('click', () => {
    const next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    html.setAttribute('data-theme', next);
    if (label) label.textContent = next === 'light' ? '◐ Light' : '◑ Dark';
    localStorage.setItem('theme', next);
  });

  // Kathmandu live clock (NPT = UTC+5:45)
  const clockEl = document.getElementById('npt-clock');
  const nptFmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Asia/Kathmandu',
    hour: '2-digit', minute: '2-digit', second: '2-digit',
    hour12: false,
  });
  function tickClock() {
    if (clockEl) clockEl.textContent = nptFmt.format(new Date());
  }
  tickClock();
  setInterval(tickClock, 1000);

  // Mountain parallax
  const heroEl = document.getElementById('hero');
  function updateMtnParallax() {
    const y = window.scrollY;
    if (!heroEl || y > heroEl.offsetHeight * 1.2) return;
    document.documentElement.style.setProperty('--mtn-p1', (y * 0.08) + 'px');
    document.documentElement.style.setProperty('--mtn-p2', (y * 0.18) + 'px');
    document.documentElement.style.setProperty('--mtn-p3', (y * 0.32) + 'px');
  }
  window.addEventListener('scroll', updateMtnParallax, { passive: true });
  updateMtnParallax();

  // Scroll reveal
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
