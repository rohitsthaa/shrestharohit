---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts');
const tags = [...new Set(allPosts.map(post => post.data.tags).flat())];
const tagCounts = {};

// Count posts per tag
allPosts.forEach(post => {
  post.data.tags?.forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

// Sort tags alphabetically
const sortedTags = tags.sort((a, b) => a.localeCompare(b));
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout title="Tags" description="All tags used in posts">
  <div class="page tags-page">
    <p class="eyebrow">Topics</p>
    <h1 class="posts-title">Tags</h1>
    <p class="tags-intro">Browse writing by topic and jump into related implementation notes.</p>
    
    <div class="tags-list">
      {sortedTags.map(tag => (
        <a href={`${base}tags/${tag}/`} class="tag-item">
          <span class="tag-name">#{tag}</span>
          <span class="tag-count">({tagCounts[tag]})</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .tags-page {
    max-width: 900px;
  }

  .tags-intro {
    max-width: 620px;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 2rem;
  }
  
  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 2.75rem;
    padding: .65rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, .64);
    text-decoration: none;
    transition: background .18s ease, border-color .18s ease, transform .18s ease;
  }
  
  .tag-item:hover {
    transform: translateY(-1px);
    border-color: var(--accent-soft);
    background: var(--accent-soft);
  }
  
  .tag-name {
    color: var(--accent);
    font-weight: 800;
  }
  
  .tag-count {
    color: var(--muted);
    font-size: .9rem;
  }
</style>
